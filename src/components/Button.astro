---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'whatsapp';
  external?: boolean;
  class?: string;
}
const { href, variant = 'primary', external = false, class: className = '' } = Astro.props;

// Radio 5px y padding 20/40 conservados del sitio original.
const base =
  'inline-flex items-center justify-center gap-2 rounded-[5px] px-8 py-4 font-display text-[17px] font-bold transition focus-visible:outline-3';

const variants = {
  primary: 'bg-brand-500 text-white hover:bg-brand-600',
  // El original tenía el borde en rgba(...,0): invisible. Aquí sí se ve.
  secondary: 'border-2 border-brand-500 text-brand-600 hover:bg-brand-50',
  ghost: 'border-2 border-ink-300 text-ink-700 hover:border-ink-500 hover:text-ink-900',
  whatsapp: 'bg-whatsapp text-white hover:brightness-95',
} as const;

const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a href={href} target={target} rel={rel} class:list={[base, variants[variant], className]}>
  <slot />
</a>
