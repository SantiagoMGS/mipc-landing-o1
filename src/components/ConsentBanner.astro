---
const enabled = Boolean(import.meta.env.PUBLIC_GA4_ID || import.meta.env.PUBLIC_GOOGLE_ADS_ID);

// Inline y dentro del condicional: sin IDs configurados no se emite ni una línea.
const logica = `
(function () {
  var CLAVE = 'mipc-consent';
  var banner = document.getElementById('consent-banner');
  if (!banner) return;

  var guardado = null;
  try { guardado = localStorage.getItem(CLAVE); } catch (e) {}
  if (guardado !== 'granted' && guardado !== 'denied') banner.hidden = false;

  banner.addEventListener('click', function (e) {
    var btn = e.target && e.target.closest ? e.target.closest('[data-consent]') : null;
    if (!btn) return;

    var decision = btn.getAttribute('data-consent') === 'granted' ? 'granted' : 'denied';
    try { localStorage.setItem(CLAVE, decision); } catch (e) {}

    if (typeof window.gtag === 'function') {
      window.gtag('consent', 'update', {
        ad_storage: decision,
        ad_user_data: decision,
        ad_personalization: decision,
        analytics_storage: decision
      });
      window.gtag('set', 'ads_data_redaction', decision === 'denied');
    }

    banner.hidden = true;
  });
})();
`;
---

{
  enabled && (
    <>
      <div
        id="consent-banner"
        hidden
        role="dialog"
        aria-labelledby="consent-title"
        class="fixed inset-x-0 bottom-0 z-[60] border-t-4 border-brand-500 bg-white p-5 shadow-[0_-4px_20px_rgba(0,0,0,0.12)]"
      >
        <div class="container-mipc flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-3xl">
            <h2 id="consent-title" class="font-display text-lg font-bold text-ink-900">
              Uso de cookies
            </h2>
            <p class="mt-1 text-[15px]">
              Usamos cookies propias y de Google para entender cómo se usa el sitio y medir la
              efectividad de nuestra publicidad. Puedes rechazarlas y el sitio funcionará igual.
              Consulta nuestra <a href="/privacidad/" class="text-brand-700 underline">política de
              tratamiento de datos</a>.
            </p>
          </div>
          <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
            <button
              type="button"
              data-consent="denied"
              class="rounded-[5px] border-2 border-ink-300 px-6 py-3 font-display font-bold text-ink-700 transition hover:border-ink-500"
            >
              Rechazar
            </button>
            <button
              type="button"
              data-consent="granted"
              class="rounded-[5px] bg-brand-600 px-6 py-3 font-display font-bold text-white transition hover:bg-brand-700"
            >
              Aceptar
            </button>
          </div>
        </div>
      </div>
      <script is:inline set:html={logica} />
    </>
  )
}
