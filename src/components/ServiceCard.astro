---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  summary: string;
  href: string;
  image?: ImageMetadata;
}
const { title, summary, href, image } = Astro.props;
---

<article class="group flex h-full flex-col rounded-[10px] border border-ink-100 bg-white p-7 transition hover:border-brand-500 hover:shadow-lg">
  {image && (
    <Image
      src={image}
      alt=""
      widths={[160, 320]}
      sizes="160px"
      loading="lazy"
      class="mb-4 h-32 w-auto self-start object-contain"
    />
  )}
  <h3 class="font-display text-xl font-bold text-ink-900">{title}</h3>
  <p class="mt-3 flex-1 text-[16px] leading-relaxed">{summary}</p>
  <a
    href={href}
    class="mt-5 inline-flex items-center gap-1 font-display font-bold text-brand-600 group-hover:text-brand-700"
  >
    + Información
    <span aria-hidden="true" class="transition group-hover:translate-x-1">&rarr;</span>
    <span class="sr-only">sobre {title}</span>
  </a>
</article>
