---
import { NAV, CONTACT, SITE, waLink } from '@/consts';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-50 bg-white shadow-sm">
  <!-- Barra superior: el teléfono es enlace tel:, no texto plano.
       Las redes quedan solo en el footer mientras los perfiles estén inactivos. -->
  <div class="bg-ink-900 text-white">
    <div class="container-mipc flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-2 text-sm">
      <a
        href={`tel:${CONTACT.phoneIntl}`}
        class="inline-flex items-center gap-2 font-semibold hover:text-brand-100 transition"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .7-.2 1l-2.3 2.2z" />
        </svg>
        {CONTACT.phoneDisplay}
      </a>
      <p class="text-ink-300">
        <span class="hidden md:inline">{CONTACT.neighborhood}, {CONTACT.city}</span>
        <span class="hidden md:inline" aria-hidden="true"> · </span>
        <span>Lun-Vie 8:00 a.m. – 5:00 p.m.</span>
      </p>
    </div>
  </div>

  <div class="container-mipc flex items-center justify-between gap-4 py-3">
    <a href="/" class="shrink-0" aria-label={`${SITE.name} — Inicio`}>
      <img
        src="/logo-mipc.svg"
        alt="MiPC Tecnología"
        width="100"
        height="48"
        loading="eager"
        fetchpriority="high"
        class="h-12 w-auto"
      />
    </a>

    <nav class="hidden lg:block" aria-label="Navegación principal">
      <ul class="flex items-center gap-6">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'font-body font-medium transition hover:text-brand-500',
                isActive(item.href) ? 'text-brand-600' : 'text-ink-700',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href={waLink()}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden rounded-[5px] bg-brand-600 px-6 py-3 font-display text-[17px] font-bold text-white transition hover:bg-brand-700 lg:inline-block"
    >
      Cotizar
    </a>

    <button
      type="button"
      id="nav-toggle"
      class="lg:hidden inline-flex items-center gap-2 rounded-[5px] border-2 border-ink-300 px-3 py-2 font-display font-bold text-ink-700"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
      </svg>
      Menú
    </button>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-ink-100 lg:hidden" aria-label="Navegación móvil">
    <ul class="container-mipc py-2">
      {NAV.map((item) => (
        <li>
          <a
            href={item.href}
            class="block border-b border-ink-100 py-3 font-medium text-ink-700 hover:text-brand-500"
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="flex gap-3 py-4">
        <a href={`tel:${CONTACT.phoneIntl}`} class="flex-1 rounded-[5px] border-2 border-brand-500 px-4 py-3 text-center font-display font-bold text-brand-700">
          Llamar
        </a>
        <a href={waLink()} target="_blank" rel="noopener noreferrer" class="flex-1 rounded-[5px] bg-brand-600 px-4 py-3 text-center font-display font-bold text-white">
          WhatsApp
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
