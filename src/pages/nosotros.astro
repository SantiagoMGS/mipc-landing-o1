---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Stats from '@/components/Stats.astro';
import CtaQuote from '@/components/CtaQuote.astro';
import ClientLogos from '@/components/ClientLogos.astro';
import { SITE, CONTACT } from '@/consts';

const queHacemos = [
  'Asistencia remota al usuario',
  'Reparación y mantenimiento de computadores',
  'Instalación de cámaras de seguridad (CCTV)',
  'Instalación y configuración de controles de acceso',
  'Diseño e instalación de redes de datos y WiFi',
  'Diseño e instalación de redes eléctricas',
  'Suministro de licenciamiento de software',
  'Suministro de partes y accesorios de computadores',
  'Venta y alquiler de computadores',
];
---

<BaseLayout
  title="Sobre Nosotros — 15 años en tecnología en Medellín | MiPC"
  description="MI PC TECNOLOGÍA S.A.S. es una empresa 100% colombiana fundada en 2009 en Laureles, Medellín. Expertos en soporte TI, redes de datos y seguridad electrónica."
>
  <section class="bg-brand-50 py-14">
    <div class="container-mipc">
      <h1 class="font-display text-4xl font-bold text-ink-900">Acerca de nosotros</h1>
      <p class="mt-4 max-w-3xl text-xl text-brand-700">
        Somos su aliado estratégico en el sector tecnológico.
      </p>
    </div>
  </section>

  <section class="py-14">
    <div class="container-mipc prose-mipc max-w-3xl">
      <p>
        Somos una empresa <strong>100 % colombiana</strong>, con sede única y principal en la ciudad
        de <strong>{CONTACT.city}</strong>. Nuestro recorrido profesional abarca más de 15 años de
        experiencia trabajando en el área tecnológica con empresas e instituciones del sector
        privado y público.
      </p>
      <p>
        <strong>{SITE.name}</strong> fue fundada en <strong>{SITE.foundingYear}</strong> y
        actualmente nos ubicamos en el sector de <strong>{CONTACT.neighborhood}</strong>.
      </p>
      <p>
        Somos expertos brindando soporte en el área de TI —en software, hardware y ofimática—
        además de contar con servicios especializados en infraestructura de redes de datos, cámaras
        de seguridad y controles de acceso.
      </p>
    </div>
  </section>

  <Stats />

  <section class="py-16">
    <div class="container-mipc">
      <h2 class="font-display text-3xl font-bold text-ink-900">Qué hacemos</h2>
      <p class="mt-4 max-w-3xl">
        Somos un aliado estratégico con una serie de soluciones y servicios enfocados en el
        desarrollo y acompañamiento tecnológico de nuestros clientes, con el fin de aumentar su
        productividad, garantizar su seguridad informática y automatizar tareas del día a día.
      </p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {queHacemos.map((item) => (
          <li class="flex items-start gap-2 rounded-[10px] border border-ink-100 p-4">
            <svg class="mt-1 shrink-0 text-brand-500" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="text-[16px]">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ClientLogos />
  <CtaQuote />
</BaseLayout>
