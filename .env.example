# Clave pública de Web3Forms (identifica el buzón destino, no es un secreto).
# Obtenla gratis en https://web3forms.com con el correo soporte@mipc.com.co
PUBLIC_WEB3FORMS_KEY=

# --- Analítica y publicidad (opcionales) ---
# Sin estos valores no se carga nada de Google y el banner de cookies no aparece.

# ID de medición de Google Analytics 4, formato G-XXXXXXXXXX
PUBLIC_GA4_ID=

# ID de Google Ads, formato AW-XXXXXXXXXX
PUBLIC_GOOGLE_ADS_ID=

# Etiqueta de conversión de Google Ads, formato AW-XXXXXXXXXX/AbC-D_efGh12_34
# Opcional: la ruta recomendada es marcar generate_lead como evento clave en GA4
# e importarlo a Google Ads.
PUBLIC_ADS_CONVERSION_SEND_TO=
